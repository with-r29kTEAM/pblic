function listDirEntries($dir) {
    $h = @opendir($dir);
    if ($h === false) return array();
    $items = array();
    while (false !== ($e = readdir($h))) {
        if ($e === '.' || $e === '..') continue;
        $items[] = $e;
    }
    closedir($h);
    return $items;
}

function listImmediateFolders($dir) {
    $dir = normalizePath($dir);
    $out = array();
    foreach (listDirEntries($dir) as $name) {
        $full = safeJoin($dir, $name);
        if (is_link($full)) {
            continue;
        }
        $real = @realpath($full);
        if ($real === false || !is_dir($real)) {
            continue;
        }
        $out[] = array(
            'name' => $name,
            'path' => normalizePath($real),
        );
    }
    usort($out, function ($a, $b) {
        return strnatcasecmp($a['name'], $b['name']);
    });
    return $out;
}

function isListableHtmlFile($name) {
