if (!function_exists('hash_equals')) {
    function hash_equals($a, $b) {
        if (!is_string($a) || !is_string($b)) return false;
        $len = strlen($a);
        if ($len !== strlen($b)) return false;
        $res = 0;
        for ($i = 0; $i < $len; $i++) $res |= ord($a[$i]) ^ ord($b[$i]);
        return $res === 0;
    }
}

function wr29k_random_bytes($len) {
    if (is_fn_usable('random_bytes')) return random_bytes($len);
    if (is_fn_usable('openssl_random_pseudo_bytes')) {
        $strong = false;
        $b = openssl_random_pseudo_bytes($len, $strong);
        if ($b !== false && $strong) return $b;
    }
    $out = '';
    for ($i = 0; $i < $len; $i++) $out .= chr(mt_rand(0, 255));
    return $out;
}

function safeJoin($base, $child) {
    $child = str_replace("\0", '', $child);
    if ($child === '') return $base;
    if ($child[0] === DIRECTORY_SEPARATOR || preg_match('~^[A-Za-z]:\\\\~', $child)) return $child;
    return rtrim($base, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $child;
}

function normalizePath($path) {
    $path = str_replace("\0", '', (string) $path);
    $path = rtrim($path, DIRECTORY_SEPARATOR);
    if ($path === '') return DIRECTORY_SEPARATOR;
    return $path;
}

function resolveUploadRoot() {
    $root = (string) UPLOAD_ROOT;
    if ($root === '') {
        $root = __DIR__;
    }
    $real = @realpath($root);
    return normalizePath($real !== false ? $real : $root);
}

function isPathInsideRoot($path, $root) {
    $path = normalizePath($path);
    $root = normalizePath($root);
    if ($path === $root) return true;
    $prefix = $root . DIRECTORY_SEPARATOR;
    if (strlen($path) < strlen($prefix)) return false;
    return substr($path, 0, strlen($prefix)) === $prefix;
}

function uploadRootLocked() {
    return (string) UPLOAD_ROOT !== '';
}

function jailPath($requested) {
    $requested = trim((string) $requested);
    if ($requested === '') {
        $requested = __DIR__;
    }
    $candidate = normalizePath($requested);
    $real = @realpath($candidate);
    if ($real === false || !is_dir($real)) {
        $fallback = @realpath(__DIR__);
        return normalizePath($fallback !== false ? $fallback : __DIR__);
    }
    $candidate = normalizePath($real);

    if (!uploadRootLocked()) {
        return $candidate;
    }

    $root = resolveUploadRoot();
    if (!is_dir($root)) {
        return $root;
    }
    if (!isPathInsideRoot($candidate, $root)) {
        return $root;
    }
    return $candidate;
}

function isProtectedDeletePath($target) {
    $target = normalizePath($target);
    if ($target === normalizePath(DIRECTORY_SEPARATOR)) {
        return true;
    }

    $self = normalizePath(@realpath(__FILE__) ?: __FILE__);
    $selfDir = normalizePath(dirname($self));
    if ($target === $self || $target === $selfDir) {
        return true;
    }
    if (strpos($self . DIRECTORY_SEPARATOR, $target . DIRECTORY_SEPARATOR) === 0) {
        return true;
    }

    if (uploadRootLocked()) {
        $root = resolveUploadRoot();
        if ($target === $root || !isPathInsideRoot($target, $root)) {
            return true;
        }
    }
    return false;
}

