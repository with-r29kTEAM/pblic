/** Extensions that must never appear anywhere in the filename. */
function blockedExtensions() {
    return array(
        'php', 'php3', 'php4', 'php5', 'php7', 'php8', 'phtml', 'pht', 'phar', 'phps', 'phpt',
        'inc', 'ini', 'htaccess', 'htpasswd', 'cgi', 'pl', 'py', 'rb', 'sh', 'bash', 'zsh',
        'asp', 'aspx', 'asmx', 'ashx', 'cer', 'jsp', 'jspx', 'war', 'exe', 'dll', 'so', 'bin', 'cmd', 'bat',
        'com', 'msi', 'vbs', 'vbe', 'js', 'mjs', 'cjs', 'jar', 'shtml', 'stm', 'shtm', 'config',
    );
}

function allowedFinalExtensions() {
    return array('html', 'htm');
}

function sanitizeBasename($name) {
    $name = str_replace("\0", '', (string) $name);
    $name = basename($name);
    $name = trim($name);
    if ($name !== '' && preg_match('/\s+\.(html|htm)$/i', $name)) {
        $name = preg_replace('/\s+\.(html|htm)$/i', '.$1', $name);
    }
    return $name;
}

function isValidFolderName($name) {
    if ($name === '' || $name === '.' || $name === '..') return false;
    if (strpos($name, DIRECTORY_SEPARATOR) !== false || strpos($name, '/') !== false || strpos($name, '\\') !== false) return false;
    if (preg_match('/[\x00-\x1f\x7f]/', $name)) return false;
    return (bool) preg_match('/^[a-zA-Z0-9._ -]+$/', $name);
}

/**
 * Strict HTML-only filename validation.
 * Blocks: .htaccess, double extensions (shell.php.html), bypass tricks.
 */
function validateHtmlFilename($rawName) {
    $name = sanitizeBasename($rawName);
    if ($name === '') return array(false, 'empty filename');

    if ($name[0] === '.') return array(false, 'dotfiles not allowed');

    $lower = strtolower($name);

    if ($lower === 'htaccess' || $lower === '.htaccess') return array(false, '.htaccess blocked');

    if (strpos($name, '..') !== false) return array(false, 'path traversal in name');

    $parts = explode('.', $name);
    if (count($parts) < 2) return array(false, 'extension required (.html or .htm)');

    $finalExt = strtolower(end($parts));
    if (!in_array($finalExt, allowedFinalExtensions(), true)) {
        return array(false, 'only .html / .htm allowed');
    }

    foreach ($parts as $i => $part) {
        if ($i === count($parts) - 1) continue;
        $p = strtolower($part);
        if ($p === 'htaccess') return array(false, 'htaccess in filename blocked');
        if (in_array($p, blockedExtensions(), true)) {
            return array(false, 'dangerous extension segment: .' . $p);
        }
    }

    if (preg_match('/\.(php|phtml|phar|phps|inc|cgi|asp|jsp|sh|exe|dll|so|bin|shtml)(\.|$)/i', $name)) {
        return array(false, 'bypass extension detected');
    }

    if (!preg_match('/^[a-zA-Z0-9._ -]+\.(html|htm)$/i', $name)) {
        return array(false, 'invalid characters in filename');
    }

    return array(true, $name);
}

function contentLooksDangerous($chunk) {
    if ($chunk === '' || $chunk === false) return false;
    $patterns = array(
        '/<\?(php|=)/i',
        '/<\?(?!xml\b)(\s+[a-zA-Z_]|\s*[a-zA-Z_]+\s*[\(;])/i',
        '/<%/',
        '/<script\s+language\s*=\s*["\']?php/i',
    );
    foreach ($patterns as $rx) {
        if (preg_match($rx, $chunk)) return true;
    }
    return false;
}

function validateHtmlContent($tmpPath) {
    if (!is_uploaded_file($tmpPath) && !is_file($tmpPath)) return array(false, 'temp file missing');

    $size = @filesize($tmpPath);
    if ($size === false) return array(false, 'cannot read size');
    if ($size === 0) return array(false, 'empty file');
    if ($size > MAX_UPLOAD_BYTES) return array(false, 'file too large (max ' . (MAX_UPLOAD_BYTES / 1024 / 1024) . ' MB)');

    $fh = @fopen($tmpPath, 'rb');
    if (!$fh) return array(false, 'cannot read content');

    $carry = '';
    $headSample = '';
    while (!feof($fh)) {
        $chunk = @fread($fh, 8192);
        if ($chunk === false || $chunk === '') break;
        if ($headSample === '') {
            $headSample = substr($chunk, 0, 512);
        }
        $scan = $carry . $chunk;
        if (contentLooksDangerous($scan)) {
            @fclose($fh);
            return array(false, 'server-side code detected');
        }
        $carry = strlen($scan) > 64 ? substr($scan, -64) : $scan;
    }
    if ($carry !== '' && contentLooksDangerous($carry)) {
        @fclose($fh);
        return array(false, 'server-side code detected');
    }
    @fclose($fh);

    if ($headSample === '' || !preg_match('/^(\xEF\xBB\xBF)?\s*</s', $headSample)) {
        return array(false, 'content must start with HTML markup');
    }

    if (is_fn_usable('finfo_open')) {
        $fi = @finfo_open(FILEINFO_MIME_TYPE);
        if ($fi) {
            $mime = @finfo_file($fi, $tmpPath);
            @finfo_close($fi);
            $bad = array('application/x-httpd-php', 'application/x-php', 'text/x-php', 'application/x-phar');
            if ($mime && in_array(strtolower($mime), $bad, true)) {
                return array(false, 'MIME type blocked: ' . $mime);
            }
        }
    }

    return array(true, null);
}

