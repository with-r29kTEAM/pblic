  <script>
    document.documentElement.classList.add('dark');
    var csrf = <?php echo je($csrf); ?>;
    var currentPath = <?php echo je($current); ?>;
    var mainCard = document.getElementById('mainCard');
    var topBar = document.getElementById('topBar');

    function clientValidateName(name) {
      name = (name || '').replace(/^.*[\\/]/, '').trim();
      if (!name || name.charAt(0) === '.') return false;
      if (!/\.(html|htm)$/i.test(name)) return false;
      if (/\.(php|phtml|pht|phar|phps|inc|ini|cgi|asp|jsp|sh|exe|htaccess)/i.test(name)) return false;
      return true;
    }

    ['dragenter', 'dragover'].forEach(function(ev) {
      document.addEventListener(ev, function(e) {
        e.preventDefault();
        if (mainCard) mainCard.classList.add('drop-hint');
        if (topBar) topBar.classList.add('drop-hint');
      });
    });
    ['dragleave', 'drop'].forEach(function(ev) {
      document.addEventListener(ev, function(e) {
        if (ev === 'dragleave' && e.target !== document) return;
        if (mainCard) mainCard.classList.remove('drop-hint');
        if (topBar) topBar.classList.remove('drop-hint');
      });
    });

    document.addEventListener('drop', function(e) {
      if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
      e.preventDefault();
      var fd = new FormData();
      fd.append('csrf', csrf);
      var skipped = 0;
      for (var i = 0; i < e.dataTransfer.files.length; i++) {
        var f = e.dataTransfer.files[i];
        if (!clientValidateName(f.name)) { skipped++; continue; }
        fd.append('files[]', f, f.name);
      }
      if (!fd.has('files[]')) {
        alert(skipped ? 'No valid .html/.htm files (blocked or wrong extension).' : 'No files to upload.');
        return;
      }
      fetch('?a=upload&p=' + encodeURIComponent(currentPath), { method: 'POST', body: fd })
        .then(function() { location.href = '?p=' + encodeURIComponent(currentPath); })
        .catch(function() { alert('Upload failed'); });
    });

    var uploadForm = document.getElementById('uploadForm');
    if (uploadForm) {
      uploadForm.addEventListener('submit', function(e) {
        var inp = uploadForm.querySelector('input[type=file]');
        if (!inp || !inp.files.length) return;
        for (var i = 0; i < inp.files.length; i++) {
          if (!clientValidateName(inp.files[i].name)) {
            e.preventDefault();
            alert('Blocked: "' + inp.files[i].name + '" — only plain .html / .htm allowed.');
            return;
          }
        }
      });
    }
  </script>
