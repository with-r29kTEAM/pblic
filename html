function wr29k_write_ip_locks($data) {
    $now = time();
    foreach ($data as $ip => $row) {
        $until = isset($row['until']) ? (int) $row['until'] : 0;
        $failures = isset($row['failures']) ? (int) $row['failures'] : 0;
        if ($until <= $now && $failures <= 0) unset($data[$ip]);
    }
    @file_put_contents(wr29k_login_lock_file(), json_encode($data), LOCK_EX);
}

