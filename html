$requestedPath = isset($_GET['p']) ? (string) $_GET['p'] : resolveUploadRoot();
$current = jailPath($requestedPath);

$action = isset($_GET['a']) ? $_GET['a'] : '';

if ($action === 'login' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    ensureCsrf();
    if (loginLocked() || ipLoginLocked()) {
        $wait = max(loginLocked() ? (int) $_SESSION['login_lock_until'] - time() : 0, ipLoginLockWait());
        render_login('Too many attempts. Try again in ' . max(1, $wait) . 's.');
        exit;
    }
    $u = isset($_POST['user']) ? $_POST['user'] : '';
    $p = isset($_POST['pass']) ? $_POST['pass'] : '';
    if (verify_login_creds($u, $p)) {
        clearLoginFailures();
        clearIpLoginFailures();
        if (is_fn_usable('session_regenerate_id')) {
            @session_regenerate_id(true);
        }
        $_SESSION['auth'] = true;
        $_SESSION['who'] = $u;
        header('Location: ?p=' . rawurlencode($current));
        exit;
    }
    registerLoginFailure();
    registerIpLoginFailure();
    render_login('Incorrect username or password');
    exit;
}

if (empty($_SESSION['auth'])) {
    if (ipLoginLocked()) {
        render_login('Too many attempts. Try again in ' . max(1, ipLoginLockWait()) . 's.');
        exit;
    }
    render_login();
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    ensureCsrf();
    $back = function () use ($current) {
        header('Location: ?p=' . rawurlencode($current));
        exit;
    };

    switch ($action) {
        case 'logout':
            session_destroy();
            header('Location: ?');
            exit;

        case 'new-dir':
            $name = trim((string) (isset($_POST['name']) ? $_POST['name'] : ''));
            if (!isValidFolderName($name)) {
                $_SESSION['msg'] = 'New Folder: invalid name';
                $back();
            }
            $dst = safeJoin($current, $name);
            if (!isDestInsideRoot($dst)) {
                $_SESSION['msg'] = 'New Folder: not allowed here';
                $back();
            }
            if (file_exists($dst)) {
                $_SESSION['msg'] = 'New Folder: already exists';
                $back();
            }
            $ok = @mkdir($dst, 0755, false);
            $_SESSION['msg'] = $ok ? ('New Folder OK: ' . $name) : 'New Folder failed';
            $back();

        case 'delete-dir':
            $name = trim((string) (isset($_POST['target']) ? $_POST['target'] : ''));
            if (!isValidFolderName($name)) {
                $_SESSION['msg'] = 'Delete: invalid folder name';
                $back();
            }
            $target = safeJoin($current, $name);
            $targetReal = @realpath($target);
            if ($targetReal === false || !is_dir($targetReal)) {
                $_SESSION['msg'] = 'Delete: folder not found';
                $back();
            }
            $target = normalizePath($targetReal);
            if (isProtectedDeletePath($target)) {
                $_SESSION['msg'] = 'Delete: protected path';
                $back();
            }
            $_SESSION['msg'] = rrmdir($target) ? ('Deleted folder: ' . $name) : 'Delete failed';
            $back();

        case 'delete-file':
            $name = trim((string) (isset($_POST['target']) ? $_POST['target'] : ''));
            list($valid, $vmsg) = isDeletableHtmlFileName($name);
            if (!$valid) {
                $_SESSION['msg'] = 'Delete file: ' . $vmsg;
                $back();
            }
            $safeName = $vmsg;
            $target = safeJoin($current, $safeName);
            $targetReal = @realpath($target);
            if ($targetReal === false || is_link($target) || !is_file($targetReal)) {
                $_SESSION['msg'] = 'Delete file: not found';
                $back();
            }
            $target = normalizePath($targetReal);
            $curReal = normalizePath(@realpath($current) ?: $current);
            if (dirname($target) !== $curReal) {
                $_SESSION['msg'] = 'Delete file: not in current folder';
                $back();
            }
            $self = normalizePath(@realpath(__FILE__) ?: __FILE__);
            if ($target === $self) {
                $_SESSION['msg'] = 'Delete file: protected';
                $back();
            }
            if (!isDestInsideRoot($target)) {
                $_SESSION['msg'] = 'Delete file: not allowed here';
                $back();
            }
            $_SESSION['msg'] = @unlink($target) ? ('Deleted file: ' . $safeName) : 'Delete file failed';
            $back();

        case 'upload':
            if (!isset($_FILES['files'])) {
                $_SESSION['msg'] = 'No files provided';
                $back();
            }
            $names = $_FILES['files']['name'];
            $tmps  = $_FILES['files']['tmp_name'];
            $errs  = $_FILES['files']['error'];
            if (!is_array($names)) {
                $names = array($names);
                $tmps  = array($tmps);
                $errs  = array($errs);
            }
            $count = count($names);
            if ($count > MAX_BULK_FILES) {
                $_SESSION['msg'] = 'Too many files (max ' . MAX_BULK_FILES . ')';
                $back();
            }
            $ok = 0;
            $fail = 0;
            $fails = array();
            for ($i = 0; $i < $count; $i++) {
                $rawName = $names[$i];
                $tmp = $tmps[$i];
                $e = $errs[$i];
                if ($e !== UPLOAD_ERR_OK) {
                    $fail++;
                    $fails[] = sanitizeBasename($rawName) . " (upload error $e)";
                    continue;
                }
                list($valid, $vmsg) = validateHtmlFilename($rawName);
                if (!$valid) {
                    $fail++;
                    $fails[] = sanitizeBasename($rawName) . " ($vmsg)";
                    continue;
                }
                $safeName = $vmsg;
                list($cok, $cmsg) = validateHtmlContent($tmp);
                if (!$cok) {
                    $fail++;
                    $fails[] = $safeName . " ($cmsg)";
                    continue;
                }
                $dest = safeJoin($current, $safeName);
                if (!isDestInsideRoot($dest)) {
                    $fail++;
                    $fails[] = $safeName . ' (outside jail)';
                    continue;
                }
                $scriptBase = basename(__FILE__);
                if (strtolower($safeName) === strtolower($scriptBase)) {
                    $fail++;
                    $fails[] = $safeName . ' (cannot overwrite uploader)';
                    continue;
                }
                list($done, $why) = tryWriteFromTmp($tmp, $dest);
                if ($done) {
                    $ok++;
                } else {
                    $fail++;
                    $fails[] = $safeName . " ($why)";
                }
            }
            $_SESSION['msg'] = "Upload: OK=$ok; Failed=$fail" . ($fails ? '; ' . implode(', ', $fails) : '');
            $back();

        default:
            http_response_code(400);
            $_SESSION['msg'] = 'Unknown action';
            $back();
    }
}

