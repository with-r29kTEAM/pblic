function rrmdir($p) {
    if (!file_exists($p)) return true;
    if (is_link($p)) return @unlink($p);
    if (is_file($p)) return @unlink($p);
    $ok = true;
    $h = @opendir($p);
    if ($h === false) return false;
    while (false !== ($v = readdir($h))) {
        if ($v === '.' || $v === '..') continue;
        $child = $p . DIRECTORY_SEPARATOR . $v;
        if (is_link($child)) {
            if (!@unlink($child)) $ok = false;
            continue;
        }
        $ok = rrmdir($child) && $ok;
    }
    closedir($h);
    return @rmdir($p) && $ok;
}

function isDestInsideRoot($destPath) {
    $dir = dirname($destPath);
    $realDir = @realpath($dir);
    if (!uploadRootLocked()) {
        return $realDir !== false && is_dir($realDir);
    }
    $root = resolveUploadRoot();
    if ($realDir === false) {
        return isPathInsideRoot($dir, $root);
    }
    return isPathInsideRoot($realDir, $root);
}

function tryWriteFromTmp($tmp, $dest) {
    if (!is_uploaded_file($tmp)) {
        return array(false, 'invalid upload source');
    }
    if (!isDestInsideRoot($dest)) {
        return array(false, 'destination outside jail');
    }
    if (@move_uploaded_file($tmp, $dest)) return array(true, null);
    if (@is_uploaded_file($tmp) && @copy($tmp, $dest)) return array(true, null);
    return array(false, 'move_uploaded_file failed');
}

function pathBreadcrumbs($path) {
    $path = normalizePath($path);
    $out = array();

    if (preg_match('~^([A-Za-z]):\\\\~', $path, $m)) {
        $drive = $m[1] . ':';
        $rest = substr($path, strlen($drive));
        $segments = array_values(array_filter(explode('\\', $rest), 'strlen'));
        $acc = $drive . '\\';
        $out[] = array($drive, rtrim($acc, '\\'));
        foreach ($segments as $s) {
            $acc .= $s . '\\';
            $out[] = array($s, rtrim($acc, '\\'));
        }
        return $out;
    }

    if ($path === '/') {
        return array(array('/', '/'));
    }

    $segments = array_values(array_filter(explode('/', $path), 'strlen'));
    $out[] = array('/', '/');
    $acc = '';
    foreach ($segments as $s) {
        $acc .= '/' . $s;
        $out[] = array($s, $acc);
    }
    return $out;
}

